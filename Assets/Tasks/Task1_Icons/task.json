    { "id": "icon_sword",     "label": "铁剑",     "required": true },
    { "id": "icon_shield",    "label": "木盾",     "required": true },
    { "id": "icon_bow",       "label": "长弓",     "required": true },
    { "id": "icon_staff",     "label": "法杖",     "required": true },
    { "id": "icon_ring",      "label": "戒指",     "required": true },
    { "id": "icon_amulet",    "label": "护符",     "required": true },
    { "id": "icon_scroll",    "label": "卷轴",     "required": true },
    { "id": "icon_gem",       "label": "宝石",     "required": true },
    { "id": "icon_coin",      "label": "金币",     "required": true },
    { "id": "icon_key",       "label": "钥匙",     "required": true },
    { "id": "icon_bomb",      "label": "炸弹",     "required": true },
    { "id": "icon_herb",      "label": "草药",     "required": true },
    { "id": "icon_map",       "label": "地图",     "required": true },
